{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Adjust Markdown Headers (Selection)",
      "detail": "Highlight a section first, then run this task. Opens VS Code GUI diff.",
      "type": "shell",
      "command": "py",
      "args": ["${workspaceFolder}/adjust_headers.py"],
      "options": {
        "env": {
          "SELECTED_TEXT": "${selectedText}",
          "SOURCE_FILE": "${file}",
          "CURSOR_LINE": "${lineNumber}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Adjust Markdown Headers (Full File)",
